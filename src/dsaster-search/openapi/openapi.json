{
  "openapi": "3.0.0",
  "paths": {
    "/events": {
      "get": {
        "operationId": "EventsController_find",
        "parameters": [
          {
            "name": "name",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Event"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "events"
        ]
      }
    },
    "/events/{eventId}": {
      "post": {
        "operationId": "EventsController_register",
        "parameters": [
          {
            "name": "eventId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterEventRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "400": {
            "description": "Invalid event id or body"
          },
          "409": {
            "description": "Event id is already registered"
          }
        },
        "summary": "Register an event so it appears in search results",
        "tags": [
          "events"
        ]
      }
    }
  },
  "info": {
    "title": "DSaster-Search",
    "description": "",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "Venue": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "location": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "location"
        ]
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "date": {
            "format": "date-time",
            "type": "string"
          },
          "venue": {
            "$ref": "#/components/schemas/Venue"
          }
        },
        "required": [
          "id",
          "name",
          "artist",
          "date",
          "venue"
        ]
      },
      "RegisterVenueRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "location": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "location"
        ]
      },
      "RegisterEventRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "date": {
            "format": "date-time",
            "type": "string"
          },
          "venue": {
            "$ref": "#/components/schemas/RegisterVenueRequest"
          }
        },
        "required": [
          "name",
          "artist",
          "date",
          "venue"
        ]
      }
    }
  }
}
